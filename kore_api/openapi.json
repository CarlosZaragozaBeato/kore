{
  "openapi": "3.1.0",
  "info": {
    "title": "Kore Training API",
    "description": "Local read-only views of Suunto training data",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_api_v1_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workouts": {
      "get": {
        "summary": "Workouts",
        "operationId": "workouts_api_v1_workouts_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workouts/{workout_key}": {
      "get": {
        "summary": "Workout Detail",
        "operationId": "workout_detail_api_v1_workouts__workout_key__get",
        "parameters": [
          {
            "name": "workout_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workout Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/context": {
      "get": {
        "summary": "Training Context",
        "operationId": "training_context_api_v1_agent_context_get",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 28,
              "title": "Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingContext"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DaySummary": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "sessions": {
            "type": "integer",
            "title": "Sessions"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters"
          },
          "tss_total": {
            "type": "number",
            "title": "Tss Total"
          },
          "tss_sessions": {
            "type": "integer",
            "title": "Tss Sessions"
          }
        },
        "type": "object",
        "required": [
          "day",
          "sessions",
          "duration_seconds",
          "distance_meters",
          "tss_total",
          "tss_sessions"
        ],
        "title": "DaySummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lap": {
        "properties": {
          "lap_index": {
            "type": "integer",
            "title": "Lap Index"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "distance_meters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Meters"
          },
          "avg_heart_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Heart Rate"
          }
        },
        "type": "object",
        "required": [
          "lap_index",
          "start_time",
          "duration_seconds",
          "distance_meters",
          "avg_heart_rate"
        ],
        "title": "Lap"
      },
      "Status": {
        "properties": {
          "workouts": {
            "type": "integer",
            "title": "Workouts"
          },
          "fit_files": {
            "type": "integer",
            "title": "Fit Files"
          },
          "decoded_workouts": {
            "type": "integer",
            "title": "Decoded Workouts"
          }
        },
        "type": "object",
        "required": [
          "workouts",
          "fit_files",
          "decoded_workouts"
        ],
        "title": "Status"
      },
      "TrainingContext": {
        "properties": {
          "from_date": {
            "type": "string",
            "format": "date",
            "title": "From Date"
          },
          "through_date": {
            "type": "string",
            "format": "date",
            "title": "Through Date"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "sessions": {
            "type": "integer",
            "title": "Sessions"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters"
          },
          "tss_total": {
            "type": "number",
            "title": "Tss Total"
          },
          "tss_sessions": {
            "type": "integer",
            "title": "Tss Sessions"
          },
          "tss_coverage": {
            "type": "number",
            "title": "Tss Coverage"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DaySummary"
            },
            "type": "array",
            "title": "Days"
          },
          "weeks": {
            "items": {
              "$ref": "#/components/schemas/WeekSummary"
            },
            "type": "array",
            "title": "Weeks"
          },
          "recent_workouts": {
            "items": {
              "$ref": "#/components/schemas/WorkoutBrief"
            },
            "type": "array",
            "title": "Recent Workouts"
          }
        },
        "type": "object",
        "required": [
          "from_date",
          "through_date",
          "timezone",
          "sessions",
          "duration_seconds",
          "distance_meters",
          "tss_total",
          "tss_sessions",
          "tss_coverage",
          "days",
          "weeks",
          "recent_workouts"
        ],
        "title": "TrainingContext"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeekSummary": {
        "properties": {
          "week_start": {
            "type": "string",
            "format": "date",
            "title": "Week Start"
          },
          "sessions": {
            "type": "integer",
            "title": "Sessions"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters"
          },
          "tss_total": {
            "type": "number",
            "title": "Tss Total"
          },
          "tss_sessions": {
            "type": "integer",
            "title": "Tss Sessions"
          }
        },
        "type": "object",
        "required": [
          "week_start",
          "sessions",
          "duration_seconds",
          "distance_meters",
          "tss_total",
          "tss_sessions"
        ],
        "title": "WeekSummary"
      },
      "WorkoutBrief": {
        "properties": {

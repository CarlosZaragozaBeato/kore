        "required": [
          "workout_key",
          "start_time",
          "sport",
          "duration_seconds",
          "distance_meters",
          "avg_heart_rate",
          "training_stress_score"
        ],
        "title": "WorkoutBrief"
      },
      "WorkoutDetail": {
        "properties": {
          "workout_key": {
            "type": "string",
            "title": "Workout Key"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "sport": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sport"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "distance_meters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Meters"
          },
          "avg_heart_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
